# NULL Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# If using external PostgreSQL, uncomment and set DATABASE_URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/null_db
# When DATABASE_URL is not set or empty, NULL defaults to a local persistent PostgreSQL storage directory.
DATABASE_URL=
DATABASE_DIR=./data/null_postgres

# Authentication Secrets (Generate strong random secrets for production)
JWT_SECRET=null_development_jwt_secret_key_change_in_production_9918237198273
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:1420,tauri://localhost,http://tauri.localhost

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Desktop & Mobile Client Configuration
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
