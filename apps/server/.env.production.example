# NULL Production Server Environment Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database: Provide your PostgreSQL database connection string
# Works with any PostgreSQL provider: Neon.tech, Supabase, Render, Railway, AWS RDS, etc.
DATABASE_URL=postgresql://user:password@host:5432/nulldb?sslmode=require

# Security: Generated cryptographically secure 64-character JWT Secret
# DO NOT share or commit this key
JWT_SECRET=e7bf63941a5f643e9d8924b20468e2f6cae64ec55ad9c546e492211ea15f69c0
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS: Allowed origins for Web clients (Desktop and Mobile apps connect directly via Tauri/Native HTTP)
CORS_ORIGIN=https://null-chat.yourdomain.com,tauri://localhost,http://tauri.localhost

# Storage: Directory path for uploaded media attachments (persist across restarts)
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=25
